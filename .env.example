# ---- Discord (required) ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: instant command registration for a test guild
DEV_GUILD_ID=
# Comma-separated Discord user IDs allowed to run /owner commands
OWNER_IDS=

# ---- Runtime ----
NODE_ENV=production
LOG_LEVEL=info
DATABASE_PATH=./data/ripple.db

# ---- Binaries ----
# Defaults resolve from PATH so the same file works on Windows dev and the Pi.
# Override with an absolute path if the binary is not on PATH.
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
# Optional, gitignored; only if YouTube requires sign-in for your host
YTDLP_COOKIES_PATH=

# ---- Music tuning (Raspberry Pi 3 defaults) ----
MUSIC_MAX_QUEUE_SIZE=100
MUSIC_MAX_CONCURRENT_STREAMS=2
MUSIC_DEFAULT_VOLUME=100
MUSIC_OPUS_BITRATE=96000
MUSIC_IDLE_TIMEOUT_MS=120000
MUSIC_EMPTY_CHANNEL_TIMEOUT_MS=60000
# Metadata + stream URL rows only (no media on disk). 0 disables. Default 5000 ≈ a few MB.
MUSIC_TRACK_CACHE_MAX_ROWS=5000
# Bot-level resolve throttles (multi-user safety)
MUSIC_RESOLVE_COOLDOWN_MS=5000
MUSIC_MAX_PENDING_RESOLVES_PER_GUILD=2

# ---- Legacy prefix commands (requires privileged MessageContent intent) ----
ENABLE_PREFIX_COMMANDS=false
COMMAND_PREFIX=!

# ---- Apex Legends (module disables itself if key is absent) ----
APEX_API_KEY=
APEX_MAX_TRACKED_ACCOUNTS=50
APEX_MAX_TRACKED_PER_GUILD=25
APEX_POLL_HOT_MINUTES=4
APEX_POLL_WARM_MINUTES=15
APEX_POLL_COLD_MINUTES=60

# ---- Spotify metadata (optional; links resolve via YouTube audio) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
